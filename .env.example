# Copy this file to .env and fill in real values. Never commit .env itself.

# Database
DATABASE_URL=postgresql://research_admin:research_pass@localhost:5433/research_qa

# LLM (Groq — fast inference API, hosts open models like Llama/Mixtral;
# NOT the same as xAI's "Grok" model despite the similar name)
GROQ_API_KEY=your_groq_key_here
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback LLM (optional, if you switch providers later)
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Embedding / NLI models (local, no key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
NLI_MODEL=cross-encoder/nli-deberta-v3-base

# App
APP_ENV=development
