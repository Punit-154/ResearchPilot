# Copy this file to .env and fill in real values. Never commit .env itself.

# Database
DATABASE_URL=postgresql://research_admin:research_pass@localhost:5433/research_qa

# LLM
GROK_API_KEY=your_grok_api_key_here
GROK_API_BASE=https://api.x.ai/v1

# Fallback LLM (optional, in case Grok access is delayed)
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Embedding / NLI models (local, no key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
NLI_MODEL=cross-encoder/nli-deberta-v3-base

# App
APP_ENV=development
